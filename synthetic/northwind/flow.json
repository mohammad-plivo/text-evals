       "variable_instructions": "Ask which date they would like the visit.",
       "variable_type": "string",
       "variable_format_instructions": "",
       "variable_enum_values": [],
       "configure_data_format": false,
       "collection": {
        "type": "date",
        "options": {
         "accept_past": false,
         "accept_today": false,
         "require_time": false
        },
        "required": true,
        "instructions": "A future date. Today and past dates are not possible."
       }
      },
      {

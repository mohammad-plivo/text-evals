       "variable_instructions": "Ask what budget they have in mind for regular upkeep.",
       "variable_type": "string",
       "variable_format_instructions": "",
       "variable_enum_values": [],
       "configure_data_format": false,
       "collection": {
        "type": "currency",
        "options": {
         "required_currency": true,
         "required_period": true
        },
        "required": true,
        "instructions": "An amount in US dollars and how often: per week, per month or per year."
       }
      },
      {
       "variable_name": "birth_date",
       "variable_instructions": "Ask for the account holder's date of birth.",
       "variable_type": "string",
       "variable_format_instructions": "",
       "variable_enum_values": [],

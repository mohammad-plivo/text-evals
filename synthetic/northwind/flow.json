     "leader_contract": {
      "version": 1,
      "speech_steps": [
       {
        "id": "booking_summary",
        "followup": false,
        "instructions": "Once every other detail is collected, state the service, visit date and address in one sentence, just before asking for the go-ahead.",
        "bindings": [
         {
          "name": "service",
          "source": {
           "field": "service_type"
          }
         },
         {
          "name": "date",
          "source": {
           "field": "visit_date"
          }
         },
         {
          "name": "address",
          "source": {
           "field": "service_address"
          }
         }
        ],

       "collection": {
        "type": "choice",
        "choices": [
         "deep cleaning",
         "gutter cleaning",
         "window washing",
         "carpet cleaning"
        ],
        "options": {
         "multiple": false,
         "present_options": true,
         "require_confirmation": false
        },
        "required": true,
        "instructions": "Read the four services. Anything else is not offered: say so and ask again."
       }
      },
      {
       "variable_name": "service_address",
       "variable_instructions": "Ask for the address where the visit will take place.",
       "variable_type": "string",
       "variable_format_instructions": "",
       "variable_enum_values": [],
       "configure_data_format": false,
       "collection": {
        "type": "address",
        "options": {
         "required_fields": [
          "street_address",
          "city",
          "state"
         ]

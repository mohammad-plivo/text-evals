  {
   "id": "agent",
   "type": "ai_agent_v29",
   "data": {
    "config": {
     "name": "Northwind Booking Assistant",
     "channel": "call",
     "brand_name": "Northwind Home Services",
     "timezone": "America/New_York",
     "voice_config": {
      "language": "en"
     },
     "initial_wait_time": 0,
     "allow_greeting_interruption": true,
     "instruction_attachments": [],
     "instructions": "You are Nora, the booking assistant for Northwind Home Services. This is an outbound call to someone who asked for a home-service quote on our website yesterday. Greet them, say who you are and why you are calling, and offer to set up their first visit now; it takes about five minutes.\n\nCollect the details one at a time, in this order: full name, best phone number, email, service, service address, number of rooms, pets at home, visit date, monthly budget for upkeep, the account holder's date of birth, a referral code (optional), then a 4-digit account PIN typed on the phone keypad.\n\nOnce the phone number is saved, the account lookup runs by itself. Never read out anything the lookup returns.\n\nWhen every detail is saved, sum up the service, visit date and address in one sentence and ask for the go-ahead to book. Book only after a clear yes. After a successful booking, give the arrival window and ask if there is anything else.\n\nWe offer four services: deep cleaning, gutter cleaning, window washing and carpet cleaning. Nothing else. If they ask for something else, say we don't offer it and ask them to pick one of the four.\n\nIf they ask why we need something, answer in one sentence and ask again: the email is for the booking confirmation; the budget lets us suggest the right upkeep plan; the date of birth is needed because the account holder must be 18 or older; the PIN protects the account when they call us.\n\nNever promise a price, a discount or a technician's name. Our phone number is 5 5 5, 0 1 0, 0 1 4 2.",
     "leader_profile": {
      "version": 1,
      "engine": "jev",
      "fault_policy": "gemma_autonomous",
      "scribe_close_permit": false,
      "amd": "off"
     },
     "extract_variables": [
      {
       "variable_name": "full_name",
       "variable_instructions": "Ask for the caller's first and last name.",
       "variable_type": "string",
       "variable_format_instructions": "",
       "variable_enum_values": [],
       "configure_data_format": false,
       "collection": {
        "type": "name",
        "options": {
         "first_name": true,
         "last_name": true,
         "middle_name": false
        },
        "spell_back": true,
        "required": true,
        "instructions": "First and last name of the account holder. Spell it back and wait for a yes."
       }
      },
      {
       "variable_name": "phone",
       "variable_instructions": "Ask for the best phone number to reach them.",
       "variable_type": "string",
       "variable_format_instructions": "",
       "variable_enum_values": [],
       "configure_data_format": false,
       "collection": {
        "type": "phone",
        "options": {
         "vanity": false
        },
        "required": true,
        "instructions": "A US number with its area code. Read it back and wait for a yes."
       }
      },
      {
       "variable_name": "email",
       "variable_instructions": "Ask for the email address for the booking confirmation.",
       "variable_type": "string",
       "variable_format_instructions": "",
       "variable_enum_values": [],
       "configure_data_format": false,
       "collection": {
        "type": "email",
        "required": true,
        "instructions": "Spell the address back and wait for a yes."
       }
      },
      {
       "variable_name": "service_type",

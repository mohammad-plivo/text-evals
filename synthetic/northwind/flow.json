          {
           "kind": "action",
           "action_id": "book_visit",
           "statuses": [
            "SUCCEEDED"
           ]
          }
         ]
        },
        "followup_question": "Is there anything else I can help you with?",
        "fallback_answer": "I can't help with that on this call. You can reach our team at 5 5 5, 0 1 0, 0 1 4 2."
       }
      ]

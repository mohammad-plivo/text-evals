           "kind": "action",
           "action_id": "book_visit",
           "statuses": [
            "REJECTED",
            "UNKNOWN"
           ]
          },
          {
           "kind": "action",
           "action_id": "lookup_account",
           "statuses": [
            "REJECTED",
            "UNKNOWN"
           ]
          }
         ]
        }
       }
      }

       "variable_instructions": "Ask whether they have a referral code. It is optional.",
       "variable_type": "string",
       "variable_format_instructions": "",
       "variable_enum_values": [],
       "configure_data_format": false,
       "collection": {
        "type": "text",
        "options": {
         "uppercase": true
        },
        "readback": "spell",
        "required": false,
        "instructions": "Letters and digits, stored in capitals. If they have none or would rather not say, move on."
       }
      },
      {
       "variable_name": "account_pin",
       "variable_instructions": "Ask them to type a 4-digit PIN on their phone keypad to protect the account.",
       "variable_type": "string",
       "variable_format_instructions": "",
       "variable_enum_values": [],
       "configure_data_format": false,
       "collection": {
        "type": "dtmf",
        "num_digits": 4,
        "options": {
         "ask_for_confirmation": false
        },
        "required": true,
        "instructions": "Keypad only. Never say the digits back."
       }
      },
      {
       "variable_name": "confirm_booking",
       "variable_instructions": "Ask: Shall I go ahead and book this visit for you? The summary was just spoken; do not repeat it.",
       "variable_type": "string",
       "variable_format_instructions": "",
       "variable_enum_values": [],
       "configure_data_format": false,
       "collection": {
        "type": "boolean",
        "options": {
         "require_confirmation": false
        },
        "required": true,
        "instructions": "Only a clear yes books the visit. A no means do not book."
       },
       "leader_contract": {
        "version": 1,
        "prerequisites": {
         "all": [
          {
           "kind": "speech",
           "id": "booking_summary"
          }
         ]
        }
       }
      }

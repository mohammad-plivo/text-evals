  {
   "id": "2f5efda2-e2b1-544f-a5b7-d3f17189c59c",
   "type": "ai_agent_v29",
   "data": {
    "meta": {
     "name": "AI conversation v2.9"
    },
    "_meta": null,
    "config": {
     "name": "Booking Confirmation",
     "description": "Reads the booking back and gets the caller's confirmation.",
     "channel": "call",
     "instructions": "## Goal\nRead the booking back and get the caller's confirmation.\n\n## Context\n- Service: {{Service Request.service_type}}\n- Visit date: {{Service Request.preferred_visit_date}}\n- Address: {{Service Request.service_address}}\n- On-site contact: {{Service Request.onsite_contact_name}}\n- Confirmation email: {{Service Request.contact_email}}\n\n## Task\n1. Read back the service, the visit date, the address and the on-site contact in one short summary.\n2. Collect booking_confirmed: whether everything is correct and they want to book the visit.\n3. If booking_confirmed is yes, collect reminder_preference: how they would like a reminder the day before. It is optional.\n4. If booking_confirmed is yes, select Booking Confirmed. If it is no, select Booking Not Confirmed.\n\n## Rules\n- Use only the values above; never invent a detail.",
     "instruction_attachments": null,
     "allow_greeting_interruption": true,
     "intents": [
      {
       "id": "2f53adcb-d03a-5dc1-9442-c548f4f1dfd0",
       "intent_name": "Booking Confirmed",
       "intent_instructions": "Select once booking_confirmed is yes and reminder_preference has been asked.",
       "intent_speech": {
        "intent_speech_text": "",
        "speech_enabled": false
       }
      },
      {
       "id": "c4bd0dde-84b1-5460-99db-0e08c1c3e192",
       "intent_name": "Booking Not Confirmed",
       "intent_instructions": "Select when booking_confirmed is no.",
       "intent_speech": {
        "intent_speech_text": "",
        "speech_enabled": false
       }
      }
     ],

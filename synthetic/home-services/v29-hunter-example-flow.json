   "type": "ai_agent_v29",
   "data": {
    "meta": {
     "name": "AI conversation v2.9"
    },
    "_meta": null,
    "config": {
     "name": "Caller Check",
     "description": "Confirms the caller is the account holder before the service request.",
     "channel": "call",
     "instructions": "## Goal\nConfirm you are speaking with the account holder before taking a home service request.\n\n## Context\n- The account holder on file is {{Start.http.params.customer_name}}.\n- Their city on file is {{Start.http.params.city}}.\n\n## Task\n1. Say you are calling from HomeFix Services about their home service request.\n2. Collect caller_name: the caller's full name. The name on file is {{Start.http.params.customer_name}}; pass it as the known value so the collector confirms it instead of asking from scratch.\n3. When caller_name is collected, select Caller Confirmed.\n4. If the caller says they are not {{Start.http.params.customer_name}} and nobody else on the line can make the request, select Wrong Person.\n\n## Rules\n- Ask one question at a time.\n- Never read out account details other than the name on file.",
     "instruction_attachments": null,
     "allow_greeting_interruption": true,
     "intents": [
      {
       "id": "0f8d67d4-65c7-59ed-b394-afb4fa2e24ad",
       "intent_name": "Caller Confirmed",
       "intent_instructions": "Select once caller_name has been collected and the caller has confirmed they are the account holder.",
       "intent_speech": {
        "intent_speech_text": "",
        "speech_enabled": false
       }
      },
      {
       "id": "5810c981-8b97-5535-a8aa-9e25e7285d84",
       "intent_name": "Wrong Person",
       "intent_instructions": "Select when the caller says they are not the account holder and nobody else on the line can make the service request.",
       "intent_speech": {
        "intent_speech_text": "",
        "speech_enabled": false
       }
      }
     ],
     "extract_variables": [
      {
       "id": "36c395f8-8f4c-59b3-8373-a6d0173a1e46",
       "variable_name": "caller_name",
       "variable_instructions": "The caller's full name, confirmed against the name on file.",
       "variable_type": "string",
       "variable_format_instructions": "",
       "variable_enum_values": [],
       "configure_data_format": false,
       "collection": {
        "type": "name",
        "options": {
         "first_name": true,
         "last_name": true
        },
        "choices": null,
        "choices_from_call": false,
        "num_digits": null,
        "spell_back": null,
        "fresh_question": false,
        "required": true,
        "instructions": "Confirm the caller's full name against the name on file.",
        "version": null,
        "stale": true,
        "overrides": {
         "type": "name",
         "settings": {
          "first_name": true,
          "last_name": true
         }
        }
       }
      }
     ],
     "actions": [],
     "screening_name": "Hi, this is HomeFix Services calling",
     "screening_reason": "I'm calling about your home service request.",
     "initial_wait_time": 0
    }
   }
